# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# ------------------------------------------------------------
# Supabase project seeded with the Operations_Case_Study procurement dataset
# (suppliers, contracts, purchase orders, inventory, ...). Same project the
# Auto Operators read/write. Used by app/services/supabase_client.py for the
# AI Insights operational-insights pass — optional; insight generation just
# skips that pass if these are unset.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supervity Auto workflow API key, generated at auto.supervity.ai/u/api-keys.
# NOT WIRED YET — app/services/ai_manager.py's _dispatch() is the intended
# call site (see NEXT_STEPS.md) but still just calls policy_engine directly.
# Reserved here so the real value has a documented home once that lands.
#
# Same host as the dashboard — there's no separate per-workflow URL. Which
# workflow runs is selected by `workflowId` in the request body, not by URL.
# Per auto.supervity.ai/docs/api-docs: POST /api/v1/workflow-runs/execute
# (multipart/form-data: workflowId, inputs, envs) needs THREE headers, not
# just the bearer token — Authorization: Bearer <key>, x-source: external
# (required for Custom API Keys, which is what /u/api-keys generates), and
# x-active-org: <org-key>. The Master Orchestrator's workflowId is already
# known: 019f797b-4a41-7000-8eb3-89e6cb784c04 (see
# Operations_Case_Study/Round 1 Operator/master-orchestrator-operator-export (1).json,
# top-level "rootWorkflowId").
SUPERVITY_AUTO_API_KEY=
SUPERVITY_AUTO_BASE_URL=https://auto.supervity.ai
SUPERVITY_AUTO_ORG_KEY=
SUPERVITY_AUTO_ORCHESTRATOR_WORKFLOW_ID=019f797b-4a41-7000-8eb3-89e6cb784c04

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev
