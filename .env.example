# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# ------------------------------------------------------------
# Supabase project seeded with the Operations_Case_Study procurement dataset
# (suppliers, contracts, purchase orders, inventory, ...). Same project the
# Auto Operators read/write. Used by app/services/supabase_client.py for the
# AI Insights operational-insights pass — optional; insight generation just
# skips that pass if these are unset.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supervity Auto workflow API key, generated at auto.supervity.ai/u/api-keys.
# Wired: app/services/ai_manager.py's _dispatch() calls out to this via
# app/services/supervity_auto_client.py for disruption-notice-shaped chat
# turns, gated by policy_engine as before — Auto's response is informational,
# never overrides the policy verdict.
#
# Same host as the dashboard — there's no separate per-workflow URL. Which
# workflow runs is selected by `workflowId` in the request body, not by URL.
# Per auto.supervity.ai/docs/api-docs: POST /api/v1/workflow-runs/execute
# (multipart/form-data: workflowId, inputs, envs) needs THREE headers, not
# just the bearer token — Authorization: Bearer <key>, x-source: external
# (required for Custom API Keys, which is what /u/api-keys generates), and
# x-active-org: <org-key>. The Master Orchestrator's workflowId is already
# known: 019f797b-4a41-7000-8eb3-89e6cb784c04 (see
# Operations_Case_Study/Round 1 Operator/master-orchestrator-operator-export (1).json,
# top-level "rootWorkflowId").
SUPERVITY_AUTO_API_KEY=
SUPERVITY_AUTO_BASE_URL=https://auto.supervity.ai
SUPERVITY_AUTO_ORG_KEY=
SUPERVITY_AUTO_ORCHESTRATOR_WORKFLOW_ID=019f797b-4a41-7000-8eb3-89e6cb784c04

# Bot token for a small standalone Slack app, used only so this backend can
# prove the Slack connection is live in the Data Manager (a real auth.test
# call in app/routers/data_manager.py). Separate from whatever token the
# Supervity Auto workspace itself uses to post its own approval messages —
# this one exists purely for the health check, not for sending messages.
# Create at api.slack.com/apps > your app > OAuth & Permissions > Bot User
# OAuth Token (starts with xoxb-).
SLACK_BOT_TOKEN=

# Access token for a Dropbox app (Scoped access, App folder access type) used
# to mirror the open Workbench queue to a JSON file for a secondary,
# human-browsable "Commander Queue" view (app/routers/workbench.py's
# _mirror_commander_queue) and for a live Data Manager health check
# (app/routers/data_manager.py's _check_dropbox). Create at
# dropbox.com/developers/apps > your app > Permissions tab (enable
# files.content.write + files.content.read) > Settings tab > Generate access
# token. Note: tokens generated this way are short-lived (a few hours) unless
# a refresh-token flow is set up — fine for a same-day demo, re-generate if
# it expires.
DROPBOX_TOKEN=

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev
