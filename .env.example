# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started.
#  Defaults work out of the box — just run: make up
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# ------------------------------------------------------------
# Supabase project seeded with the Operations_Case_Study procurement dataset
# (suppliers, contracts, purchase orders, inventory, ...). Same project the
# Auto Operators read/write. Used by app/services/supabase_client.py for the
# AI Insights operational-insights pass — optional; insight generation just
# skips that pass if these are unset.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supervity Auto workflow API key, generated at auto.supervity.ai/u/api-keys.
# Wired: app/services/ai_manager.py's _dispatch() calls out to this via
# app/services/supervity_auto_client.py for disruption-notice-shaped chat
# turns, gated by policy_engine as before — Auto's response is informational,
# never overrides the policy verdict.
#
# Same host as the dashboard — there's no separate per-workflow URL. Which
# workflow runs is selected by `workflowId` in the request body, not by URL.
# Per auto.supervity.ai/docs/api-docs: POST /api/v1/workflow-runs/execute
# (multipart/form-data: workflowId, inputs, envs) needs THREE headers, not
# just the bearer token — Authorization: Bearer <key>, x-source: external
# (required for Custom API Keys, which is what /u/api-keys generates), and
# x-active-org: <org-key>. The Master Orchestrator's workflowId is already
# known: 019f797b-4a41-7000-8eb3-89e6cb784c04 (see
# Operations_Case_Study/Round 1 Operator/master-orchestrator-operator-export (1).json,
# top-level "rootWorkflowId").
SUPERVITY_AUTO_API_KEY=
SUPERVITY_AUTO_BASE_URL=https://auto.supervity.ai
SUPERVITY_AUTO_ORG_KEY=
SUPERVITY_AUTO_ORCHESTRATOR_WORKFLOW_ID=019f797b-4a41-7000-8eb3-89e6cb784c04

# Public URL this backend is reachable at from Auto's cloud (a tunnel — e.g.
# ngrok, Cloudflare Tunnel — since Auto can't reach a bare localhost
# backend). supervity_auto_client.py's _build_envs() derives POLICY_API_URL
# from this (appending /api/ai/policies/evaluate) and forwards it to the
# Master Orchestrator, whose fanned-out Round 2 Operators need it to POST
# their results back. Prefer a stable/named tunnel over an ad-hoc one — a
# quick tunnel's URL changes on every restart, which silently breaks every
# Operator step wired to the old URL until each is manually re-pointed.
PUBLIC_BACKEND_URL=

# Bot token for a small standalone Slack app, used only so this backend can
# prove the Slack connection is live in the Data Manager (a real auth.test
# call in app/routers/data_manager.py). Separate from whatever token the
# Supervity Auto workspace itself uses to post its own approval messages —
# this one exists purely for the health check, not for sending messages.
# Create at api.slack.com/apps > your app > OAuth & Permissions > Bot User
# OAuth Token (starts with xoxb-).
SLACK_BOT_TOKEN=

# Dropbox app (Scoped access, App folder access type) used to mirror the
# open Workbench queue to a JSON file for a secondary, human-browsable
# "Commander Queue" view (app/routers/workbench.py's _mirror_commander_queue)
# and for a live Data Manager health check (app/routers/data_manager.py's
# _check_dropbox). Create at dropbox.com/developers/apps > your app >
# Permissions tab (enable files.content.write + files.content.read).
#
# Preferred: OAuth refresh-token flow (app/services/dropbox_client.py
# refreshes automatically, so it survives a freeze-tonight/demo-tomorrow gap
# without manual re-generation). One-time setup:
#   1. Settings tab > note the App key / App secret.
#   2. Visit (in a browser, logged into the Dropbox account that owns the
#      app's folder):
#      https://www.dropbox.com/oauth2/authorize?client_id=<APP_KEY>&response_type=code&token_access_type=offline
#   3. Approve, copy the resulting authorization code.
#   4. Exchange it for a refresh token:
#      curl https://api.dropboxapi.com/oauth2/token -d code=<CODE> -d grant_type=authorization_code -d client_id=<APP_KEY> -d client_secret=<APP_SECRET>
#   5. Put the response's refresh_token below.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Fallback: Settings tab > Generate access token. Short-lived (4 hours) with
# no way to renew — only useful for testing right before you use it, not for
# a demo that happens after a separate code-freeze. Used only if the refresh
# token above isn't set.
DROPBOX_TOKEN=

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:3001

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev
